# Runs `grm update` once a night (see grm-update.service).
#
# Install as root:
#   cp grm-update.service grm-update.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now grm-update.timer
#
# `systemctl list-timers grm-update.timer` shows the next run.

[Unit]
Description=Nightly update of packages installed by grm

[Timer]
# Start between 01:00 and 05:00 local time: the randomized delay spreads the
# requests of many machines over four hours instead of hitting GitHub and
# Forgejo instances at the same moment.
OnCalendar=*-*-* 01:00:00
RandomizedDelaySec=4h
# Derive the delay from the machine ID (and the unit name) instead of
# choosing it anew every night, so each machine keeps a stable slot in the
# window, and the machines still spread evenly across it.
FixedRandomDelay=true
# Run after booting if the machine was off at its time, e.g. a laptop.
Persistent=true

[Install]
WantedBy=timers.target
